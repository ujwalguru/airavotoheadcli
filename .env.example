# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Super Admin Credentials (set strong, unique values in Render)
ADMIN_USERNAME="set-a-unique-admin-username"
ADMIN_PASSWORD="set-a-long-random-admin-password"
JWT_SECRET="generate-a-random-32-byte-secret"

# Optional shared secret for POS heartbeat ingestion.
# When set, POS clients must send it as the X-Heartbeat-Secret header.
HEARTBEAT_SECRET="set-a-random-heartbeat-secret"

# PostgreSQL Database (Optional - defaults to SQLite/in-memory PostgreSQL emulation if not configured)
DATABASE_URL="postgres://user:password@localhost:5432/cafes_db"

# Comma-separated production website origins allowed to call public Airavoto APIs.
CORS_ORIGINS="https://your-cafe-gaming-domain.com"

